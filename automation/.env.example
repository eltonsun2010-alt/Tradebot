# Southpage Automation — environment variables
#
# Copy to `.env` (local) or set these in your host's secret store (n8n
# credentials, Cloudflare Worker secrets, serverless env). NEVER commit real
# values. Config files reference these by NAME only — no secret ever lives in
# code or in the workflow JSON.

# ── Request signing (shared between the edge signer and n8n) ─────────────────
# A long random string. Generate with: openssl rand -hex 32
SOUTHPAGE_SIGNING_SECRET=

# ── Transactional email (Resend) ─────────────────────────────────────────────
RESEND_API_KEY=

# ── Google Sheets store (service account) ────────────────────────────────────
# From the service-account JSON key file.
GOOGLE_SA_CLIENT_EMAIL=
# The private key. Keep the literal \n escapes on one line; the factory expands
# them. Example: "-----BEGIN PRIVATE KEY-----\nMII…\n-----END PRIVATE KEY-----\n"
GOOGLE_SA_PRIVATE_KEY=

# ── Edge signer (Cloudflare Worker) ──────────────────────────────────────────
# Set these as Wrangler secrets, not here, in production.
N8N_WEBHOOK_URL=
ALLOWED_ORIGIN=https://southpage.co.uk
